@tailwind base;
@tailwind components;
@tailwind utilities;

/* Design tokens (simplified and CSS-safe) */
:root {
  --font-size: 16px;
  --background: #ffffff;
  --foreground: #111827; /* fallback for oklch */
  --card: #ffffff;
  --muted: #ececf0;
  --muted-foreground: #717182;
  --accent: #e9ebef;
  --border: rgba(0,0,0,0.08);
  --input-background: #f3f3f5;
  --radius: 0.625rem;
}

/* dark mode overrides */
.dark {
  --background: #0f172a;
  --foreground: #f8fafc;
  --card: #0b1220;
}

@layer base {
  html { font-size: var(--font-size); }
  body { @apply bg-[var(--background)] text-[var(--foreground)]; }

  /* baseline typography */
  h1 { font-size: 1.5rem; font-weight: 500; line-height: 1.5; }
  h2 { font-size: 1.25rem; font-weight: 500; line-height: 1.5; }
  h3 { font-size: 1.125rem; font-weight: 500; line-height: 1.5; }
  h4 { font-size: 1rem; font-weight: 500; line-height: 1.5; }
  p, label, input, button { font-size: 1rem; line-height: 1.5; }
}

/* Page-level background and typography to match the target design */
html, body { height: 100%; }
body {
  background: linear-gradient(90deg, #eef6ff 0%, #fff3fb 100%);
  font-family: Inter, ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  padding: 2.5rem 1rem;
}

.page-header { text-align: center; margin-bottom: 1.5rem; }
.brand-badge {
  display: inline-flex; align-items: center; justify-content: center;
  width: 64px; height: 64px; border-radius: 14px;
  background: linear-gradient(135deg,#7c3aed,#06b6d4);
  box-shadow: 0 8px 30px rgba(99,102,241,0.12);
  color: white; margin: 0 auto 0.6rem auto;
}

.page-subtitle { color: #6b7280; margin-top: 0.5rem; }

.form-card-container { max-width: 992px; margin: 0 auto; }

.form-card {
  border-radius: 14px;
  background: rgba(255,255,255,0.9);
  box-shadow: 0 10px 30px rgba(2,6,23,0.06);
  padding: 2rem;
}

/* Tighter form element styles */
.input-like {
  @apply w-full rounded-md border border-gray-200 bg-[#f3f4f6] px-3 py-2 text-sm;
}

.textarea-like { @apply w-full rounded-md border border-gray-200 bg-[#f3f4f6] px-3 py-3 text-sm; }

.submit-like { @apply w-full inline-flex items-center justify-center rounded-md px-4 py-2 bg-gradient-to-r from-blue-600 to-purple-600 text-white; }
